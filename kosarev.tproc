@
import os


# A value and the sources that give it.
class Value(object):
    def __init__(self, value):
        self.value = value
        self.sources = []


# A person or a place: what the records say about it, in the register it
# belongs to.
class Subject(object):
    def __init__(self, register, id):
        self.register = register
        self.id = id
        # Each field is a list of alternative values. A value given by
        # several sources is one value with several sources.
        self.fields = {}

    # A value given by no source, such as a cross-reference, has the source
    # None.
    def add(self, field, value, source):
        values = self.fields.setdefault(field, [])
        for v in values:
            if v.value == value:
                break
        else:
            v = Value(value)
            values.append(v)
        if source is not None and source not in v.sources:
            v.sources.append(source)


# A place: a name and facts.
class Place(Subject):
    def add(self, field, value, source):
        assert field in ('place_name', 'facts'), (self.id, field)
        super().add(field, value, source)


# A person; relations not recorded on them are inferred from the register.
class Person(Subject):
    def add(self, field, value, source):
        assert field != 'place_name', (self.id, field)
        super().add(field, value, source)

    # The fields that name other people.
    RELATION_FIELDS = ('father', 'mother', 'stepfather', 'stepmother',
                       'partner')

    # The parents named by the given fields, each with the value that says
    # so; the first recorded, where there are alternatives.
    def __parents(self, fields):
        return [(self.register.subjects[self.fields[f][0].value],
                 self.fields[f][0])
                for f in fields if f in self.fields]

    # The people whose parent this is by the given fields, each with the
    # value that says so.
    def __children(self, fields):
        return [(c, v) for c in self.register.subjects.values()
                for f in fields
                for v in c.fields.get(f, []) if v.value == self.id]

    # The father and the mother.
    @property
    def parents(self):
        return self.__parents(('father', 'mother'))

    # The stepfather and stepmother.
    @property
    def stepparents(self):
        return self.__parents(('stepfather', 'stepmother'))

    # The people whose father or mother this is.
    @property
    def children(self):
        return self.__children(('father', 'mother'))

    # The people whose stepfather or stepmother this is.
    @property
    def stepchildren(self):
        return self.__children(('stepfather', 'stepmother'))

    # The partners, recorded on either side, each with a value whose sources
    # are those of all the values that say so.
    @property
    def partners(self):
        found = [(self.register.subjects[v.value], v)
                 for v in self.fields.get('partner', [])]
        found += [(q, v) for q in self.register.subjects.values()
                  for v in q.fields.get('partner', []) if v.value == self.id]
        partners = {}
        for q, v in found:
            both = partners.setdefault(q, Value(None))
            for s in v.sources:
                if s not in both.sources:
                    both.sources.append(s)
        return list(partners.items())

    # The people with the same father or mother, each with a value whose
    # sources are those of all the parents' values that make them siblings.
    @property
    def siblings(self):
        siblings = {}
        for f in ('father', 'mother'):
            for v in self.fields.get(f, []):
                parent = self.register.subjects[v.value]
                for c, w in parent.children:
                    if c is self:
                        continue
                    both = siblings.setdefault(c, Value(None))
                    for s in v.sources + w.sources:
                        if s not in both.sources:
                            both.sources.append(s)
        return list(siblings.items())


# A person known only by name: mentioned, with no record of their own.
class PersonId(Person):
    pass


# The subjects assembled from field values, each value with the sources
# that give it.
class Register(object):
    def __init__(self):
        self.subjects = {}
        # The source each id has stood for, to catch two different sources
        # under one id.
        self.__source_ids = {}

    def add_field(self, subject, field, value, source):
        if source is not None:
            known = self.__source_ids.setdefault(source.id, source)
            assert known is source, f'two sources with the id {source.id}'
        # A subject is a place if it starts with a place name, and a person
        # otherwise.
        if subject not in self.subjects:
            kind = Place if field == 'place_name' else Person
            self.subjects[subject] = kind(self, subject)
        s = self.subjects[subject]
        s.add(field, value, source)


def text(tokens):
    return ''.join(t.content for t in tokens
                   if isinstance(t.content, str)).strip()


# The rest of a field from the given argument on. tproc splits arguments
# at colons, so the colons in text come as separate arguments; this joins
# them back.
def rest(*parts):
    for i, part in enumerate(parts):
        if i:
            yield tproc.LiteralToken(':')
        yield from part


# The one value of the given tokens: an object, such as a date, or else
# the text.
def content(tokens):
    tokens = list(tokens)
    objects = [t.content for t in tokens if not isinstance(t.content, str)]
    if objects:
        assert len(objects) == 1, objects
        assert not text(tokens), tokens
        return objects[0]
    return text(tokens)


# Text with objects in it, such as citations and links: a tuple of
# strings and objects, with runs of text joined.
def pieces(tokens):
    result = []
    for t in tokens:
        if isinstance(t.content, str) and result and isinstance(result[-1],
                                                                str):
            result[-1] += t.content
        else:
            result.append(t.content)
    return tuple(result)


MONTHS = ('январь', 'февраль', 'март', 'апрель', 'май', 'июнь', 'июль',
          'август', 'сентябрь', 'октябрь', 'ноябрь', 'декабрь')
MONTHS_OF = ('января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля',
             'августа', 'сентября', 'октября', 'ноября', 'декабря')


# A date: a year, possibly with a month and a day.
class Date(object):
    def __init__(self, year, month=None, day=None):
        self.year = year
        self.month = month
        self.day = day

    def __eq__(self, other):
        return (isinstance(other, Date) and
                (self.year, self.month, self.day) ==
                (other.year, other.month, other.day))

    def __hash__(self):
        return hash((self.year, self.month, self.day))

    # The earliest and the latest day the date may be.
    def earliest(self):
        return (self.year, self.month or 1, self.day or 1)

    def latest(self):
        return (self.year, self.month or 12, self.day or 31)

    def __str__(self):
        if self.day:
            return f'{self.day} {MONTHS_OF[self.month - 1]} {self.year}'
        if self.month:
            return f'{MONTHS[self.month - 1]} {self.year}'
        return str(self.year)


# {date::year:month:day}, the month and the day being optional.
def date(*parts):
    return Date(*(int(text(p)) for p in parts))


# A date known to be between two dates.
class Between(object):
    def __init__(self, first, last):
        self.first = first
        self.last = last

    def __eq__(self, other):
        return (isinstance(other, Between) and
                (self.first, self.last) == (other.first, other.last))

    def __hash__(self):
        return hash((self.first, self.last))

    def __str__(self):
        return f'между {self.first} и {self.last}'


def between(first, last):
    return Between(content(first), content(last))


# A field's value, as given in a record.
class FieldValue(object):
    def __init__(self, field, value):
        self.field = field
        self.value = value


def place_name(value):
    return FieldValue('place_name', content(value))


def first_name(value):
    return FieldValue('first_name', content(value))


def patronym(value):
    return FieldValue('patronym', content(value))


def surname(value):
    return FieldValue('surname', content(value))


def birth_surname(value):
    return FieldValue('birth_surname', content(value))


def birth_date(value):
    return FieldValue('birth_date', content(value))


def death_date(value):
    return FieldValue('death_date', content(value))


def birth_place(*text):
    return FieldValue('birth_place', pieces(rest(*text)))


def death_place(*text):
    return FieldValue('death_place', pieces(rest(*text)))


# A link to a subject's page, with the text to show for it.
class Link(object):
    def __init__(self, id, text):
        self.id = id
        self.text = text

    def __eq__(self, other):
        return (isinstance(other, Link) and
                (self.id, self.text) == (other.id, other.text))

    def __hash__(self):
        return hash((self.id, self.text))


def link(id, *shown):
    return Link(text(id), text(rest(*shown)))


# Where a person was recorded living at a date; a person may have several
# residences, all true at once.
class Residence(object):
    def __init__(self, date, place):
        self.date = date
        self.place = place

    def __eq__(self, other):
        return (isinstance(other, Residence) and
                (self.date, self.place) == (other.date, other.place))

    def __hash__(self):
        return hash((self.date, self.place))

    # The earliest day the date may be, to order residences by.
    def earliest(self):
        d = self.date.first if isinstance(self.date, Between) else self.date
        return d.earliest()


# {residence::date:place}, the place as text, possibly with links.
def residence(when, *place):
    return FieldValue('residences',
                      Residence(content(when), pieces(rest(*place))))


# A free-text fact about the subject, possibly with links; all facts may
# be true at once.
def fact(*text):
    return FieldValue('facts', pieces(rest(*text)))


# The id of the subject's father.
def father(value):
    return FieldValue('father', content(value))


# The id of the subject's mother.
def mother(value):
    return FieldValue('mother', content(value))


# The id of the subject's stepfather, who raised them.
def stepfather(value):
    return FieldValue('stepfather', content(value))


# The id of the subject's stepmother, who raised them.
def stepmother(value):
    return FieldValue('stepmother', content(value))


# The id of one of the subject's partners; all may be true at once.
def partner(value):
    return FieldValue('partner', content(value))


# A citation of a source, by id, in the notes of another source.
class Cite(object):
    def __init__(self, id):
        self.id = text(id)


cite = Cite


# A copy of a document, kept in the repository under materials/: a
# directory with the copy and a README.md describing it, or a file in it.
# Shown as the given text, or else as its path.
class Material(object):
    def __init__(self, path, *shown):
        self.path = 'materials/' + text(path)
        self.text = text(rest(*shown)) if shown else self.path


material = Material


# A web page, as a source's provider.
class Url(object):
    def __init__(self, address):
        self.address = address

    def __str__(self):
        return self.address


def url(*address):
    return Url(text(rest(*address)))


# A piece of evidence: where it comes from -- a person, a page or a name --
# whether it is reliable, and notes on what it is: text and citations of
# other sources.
class Source(object):
    def __init__(self, id, provider, notes, reliable):
        self.id = text(id)
        self.provider = pieces(provider)
        self.reliable = reliable
        self.notes = pieces(notes)


def source(id, provider, *notes):
    return Source(id, provider, rest(*notes), reliable=True)


def unreliable_source(id, provider, *notes):
    return Source(id, provider, rest(*notes), reliable=False)


# What sources say about a subject: the values of its fields. Several
# sources, separated by spaces, all give every value.
class Record(object):
    def __init__(self, sources, subject, values):
        self.sources = text(sources).split()
        self.subject = text(subject)
        self.values = []
        for t in values:
            if isinstance(t.content, FieldValue):
                self.values.append(t.content)
            else:
                assert not t.content.strip(), t.content


record = Record


# Writes the register as Markdown: a page for each person.
class MarkdownWriter(object):
    # A place has a name; a person's name is in parts.
    NAME_FIELDS = ('place_name', 'first_name', 'patronym', 'surname')

    def __name(self, p):
        return ' '.join(p.fields[f][0].value for f in self.NAME_FIELDS
                        if f in p.fields)

    # A person as mentioned on a page: a link to their page, or just the
    # name for one known only by name; from the index, pages are one level
    # up.
    def person(self, q, up=''):
        if isinstance(q, PersonId):
            return self.__name(q)
        return f'[{self.__name(q)}]({up}{q.id}.md)'

    # First names to tell the sex by when there is neither a patronym nor
    # a surname.
    MALES = ()
    FEMALES = ('Лукерья',)

    # Tells whether a person is male by the patronym, or else by the
    # surname, or else by the first name.
    def male(self, p):
        if 'patronym' in p.fields:
            patronym = p.fields['patronym'][0].value
            if patronym.endswith('ич'):
                return True
            assert patronym.endswith('на'), patronym
            return False
        if 'surname' in p.fields:
            surname = p.fields['surname'][0].value
            if surname.endswith(('ов', 'ев', 'ин')):
                return True
            if surname.endswith(('ова', 'ева', 'ина')):
                return False
        first_name = p.fields['first_name'][0].value
        assert first_name in self.MALES + self.FEMALES, first_name
        return first_name in self.MALES

    # The title of a person's partners: «Муж» and «Жена» say nothing of
    # whether the marriage was registered.
    def __partners_title(self, partners):
        males = sum(1 for q, v in partners if self.male(q))
        if len(partners) == 1:
            return 'Муж' if males else 'Жена'
        return ('Мужья' if males == len(partners) else
                'Жёны' if not males else 'Супруги')

    # A value as text; places and facts may have links in them.
    def __shown(self, value):
        if isinstance(value, Residence):
            return f'{value.date} — {self.__shown(value.place)}'
        if isinstance(value, tuple):
            return ' '.join(''.join(f'[{x.text}]({x.id}.md)'
                                    if isinstance(x, Link) else
                                    f'[{x.text}]({x.path})'
                                    if isinstance(x, Material) else x
                                    for x in value).split())
        return str(value)

    # The age at death, in full years, or the range of the ages possible,
    # when both dates are known.
    def __age(self, p):
        if 'birth_date' not in p.fields or 'death_date' not in p.fields:
            return None
        birth = p.fields['birth_date'][0].value
        death = p.fields['death_date'][0].value
        if not isinstance(birth, Date) or not isinstance(death, Date):
            return None

        def years(a, b):
            return b[0] - a[0] - (b[1:] < a[1:])

        least = years(birth.latest(), death.earliest())
        most = years(birth.earliest(), death.latest())
        n = most % 100
        word = ('лет' if 11 <= n <= 14 else 'год' if n % 10 == 1 else
                'года' if 2 <= n % 10 <= 4 else 'лет')
        return (f'{least} {word}' if least == most else
                f'{least}–{most} {word}')

    # The middle of a person's known birth date, to order people by; those
    # of unknown birth come last.
    def __birth(self, p):
        if 'birth_date' not in p.fields:
            return float('inf')
        d = p.fields['birth_date'][0].value
        if isinstance(d, Between):
            return (d.first.year + d.last.year) / 2
        return d.year

    # Related people with their values, ordered by birth.
    def __by_birth(self, related):
        return sorted(related, key=lambda t: self.__birth(t[0]))

    # Sources are listed at the end of the page, each under a heading of its
    # id, so it can be linked to: page.md#source-id. They are numbered on
    # the page in the order they are first cited; marks link to them.
    def __write_page(self, f, p, register):
        sources = []

        def ref(source):
            if source not in sources:
                sources.append(source)
            return f'[{sources.index(source) + 1}](#{source.id})'

        # A value is reliable only if all its sources are.
        def reliable(value):
            return all(s.reliable for s in value.sources)

        def refs(value):
            if not value.sources:
                return ''
            return ('<sup>' + ('' if reliable(value) else '? ') +
                    ', '.join(ref(s) for s in value.sources) + '</sup>')

        # The given fields, joined with the separator, each with its
        # alternatives, reliable ones first, joined with «или». If all the
        # values have the same sources, only the last one is marked.
        def shown(names, separator):
            fields = [sorted(p.fields[n], key=lambda v: not reliable(v))
                      for n in names if n in p.fields]
            values = [v for alternatives in fields for v in alternatives]
            same = len(set(tuple(v.sources) for v in values)) == 1
            return separator.join(
                ' или '.join(self.__shown(v.value) +
                             (refs(v) if not same or v is values[-1] else '')
                             for v in alternatives)
                for alternatives in fields)

        # A place is headed by its main name; the others follow.
        if isinstance(p, Place):
            names = sorted(p.fields['place_name'], key=lambda v: not reliable(v))
            f.write(f'# {self.__shown(names[0].value)}{refs(names[0])}\n')
            if others := names[1:]:
                f.write('\n**Другие названия:** ' +
                        ', '.join(self.__shown(v.value) + refs(v)
                                  for v in others) + '\n')
        else:
            f.write(f'# {shown(self.NAME_FIELDS, " ")}\n')

        if 'birth_surname' in p.fields:
            f.write(f'\n({shown(("birth_surname",), "")})\n')

        def event(names):
            return shown(names, ', ')

        if 'birth_date' in p.fields or 'birth_place' in p.fields:
            f.write(f'\n**{"Родился" if self.male(p) else "Родилась"}:** '
                    f'{event(("birth_date", "birth_place"))}\n')

        if 'death_date' in p.fields or 'death_place' in p.fields:
            age = self.__age(p)
            f.write(f'\n**{"Умер" if self.male(p) else "Умерла"}:** '
                    f'{event(("death_date", "death_place"))}'
                    f'{f" ({age})" if age else ""}\n')

        # A relation's title on a line of its own, then each person on a
        # line of their own.
        def relation(title, people):
            f.write(f'\n**{title}:**\n')
            for q, v in people:
                f.write(f'- {self.person(q)}{refs(v)}{self.__years(q)}\n')

        # Only people have relations.
        if isinstance(p, Person):
            if parents := p.parents:
                title = ('Родители' if len(parents) > 1 else
                         'Отец' if 'father' in p.fields else 'Мать')
                relation(title, parents)

            if parents := p.stepparents:
                title = ('Приёмные родители' if len(parents) > 1 else
                         'Приёмный отец' if 'stepfather' in p.fields
                         else 'Приёмная мать')
                relation(title, parents)

            if partners := p.partners:
                relation(self.__partners_title(partners), partners)

            if children := self.__by_birth(p.children):
                if len(children) > 1:
                    title = 'Дети'
                else:
                    title = 'Сын' if self.male(children[0][0]) else 'Дочь'
                relation(title, children)

            if children := self.__by_birth(p.stepchildren):
                if len(children) > 1:
                    title = 'Приёмные дети'
                else:
                    title = ('Приёмный сын' if self.male(children[0][0])
                             else 'Приёмная дочь')
                relation(title, children)

            if siblings := self.__by_birth(p.siblings):
                males = sum(1 for c, v in siblings if self.male(c))
                females = len(siblings) - males
                titles = [t for t in (
                    'Братья' if males > 1 else 'Брат' if males else '',
                    'Сестры' if females > 1 else 'Сестра' if females else '')
                    if t]
                relation(' и '.join(titles[:1] +
                                    [t.lower() for t in titles[1:]]),
                         siblings)

        # Where the person was recorded living, by date, after the relations:
        # «Место» for one, «Места» for several, each on a line of its own.
        residences = sorted(p.fields.get('residences', []),
                            key=lambda v: v.value.earliest())
        if len(residences) == 1:
            v = residences[0]
            f.write(f'\n**Место:** {self.__shown(v.value)}{refs(v)}\n')
        elif residences:
            f.write('\n**Места:**\n')
            for v in residences:
                f.write(f'- {self.__shown(v.value)}{refs(v)}\n')

        # Facts come last, each a paragraph of its own.
        for v in p.fields.get('facts', []):
            f.write(f'\n{self.__shown(v.value)}{refs(v)}\n')

        # Citations in the notes add more sources as they are written.
        f.write('\n## Источники\n')
        i = 0
        while i < len(sources):
            s = sources[i]
            # A citation in the notes is marked like a value: superscript,
            # with «?» when the cited source is unreliable, after the word.
            notes = ''.join('<sup>' + ('' if n.reliable else '? ') + ref(n) +
                            '</sup>' if isinstance(n, Source) else
                            f'[{n.text}]({n.path})'
                            if isinstance(n, Material) else str(n)
                            for n in s.notes)
            # Adjacent citations share one mark, separated by commas.
            notes = ' '.join(notes.split()).replace(' <sup>', '<sup>')
            notes = notes.replace('</sup><sup>', ', ')
            provider = ''.join(str(x) for x in s.provider).strip()
            text = ' — '.join(t for t in (notes, provider) if t)
            f.write(f'\n### {s.id}\n\n'
                    f'[{i + 1}] {"" if s.reliable else "? "}{text}\n')
            i += 1

    # The years of birth and death, for the index.
    def __years(self, p):
        def years(d):
            if isinstance(d, Between):
                return f'{d.first.year}–{d.last.year}'
            return str(d.year)

        parts = [f'{prefix} {years(p.fields[n][0].value)}'
                 for n, prefix in (('birth_date', 'р.'), ('death_date', 'ум.'))
                 if n in p.fields]
        return f' ({", ".join(parts)})' if parts else ''

    def __descendants(self, p, register):
        found = set()
        for c, v in self.__by_birth(p.children):
            if c not in found:
                found |= {c} | self.__descendants(c, register)
        return found

    # A person of the index tree with their partners, and their children
    # nested under them. A link to a parent or a partner that rests on a
    # guess is marked «?». A partner is only mentioned: they still appear
    # in the tree of their own parents.
    def __write_tree(self, f, p, v, depth, register, shown, mentioned):
        def mark(v):
            reliable = all(s.reliable for s in v.sources)
            return '' if reliable else '? '

        def link(q):
            return self.person(q, '../')

        shown.add(p)
        line = (f'{"  " * depth}- {mark(v) if v else ""}{link(p)}'
                f'{self.__years(p)}')
        if partners := p.partners:
            title = self.__partners_title(partners).lower()
            line += f' — {title}: ' + ', '.join(mark(w) + link(q)
                                                for q, w in partners)
            mentioned.update(q for q, w in partners
                             if not isinstance(q, PersonId))
        f.write(line + '\n')
        for c, w in self.__by_birth(p.children):
            if c not in shown:
                self.__write_tree(f, c, w, depth + 1, register, shown,
                                  mentioned)

    # The index: a tree for each earliest known ancestor, bigger trees
    # first, so that each person is shown once, with most of their family;
    # those mentioned as partners get no tree of their own, unless they
    # have children not shown yet. Then the places.
    def __write_index(self, f, register):
        people = [p for p in register.subjects.values()
                  if isinstance(p, Person) and not isinstance(p, PersonId)]
        places = [p for p in register.subjects.values()
                  if isinstance(p, Place)]
        roots = [p for p in people
                 if all(isinstance(q, PersonId) for q, v in p.parents)]
        roots.sort(key=lambda p: (-len(self.__descendants(p, register)),
                                  not self.male(p), self.__birth(p)))
        f.write('# Косаревы\n\n'
                'Деревья — по самым ранним известным предкам; дети — под '
                'родителями, по году рождения. «?» — связь с родителем, мужем '
                'или женой предположительна.\n')
        if surnames := self.__surnames(people):
            f.write('\nФамилии: ' + ', '.join(f'{n} ({c})'
                                              for n, c in surnames) + '.\n')
        if places:
            def place(p):
                names = [v.value for v in p.fields['place_name']]
                others = f' ({", ".join(names[1:])})' if names[1:] else ''
                return f'[{names[0]}](../{p.id}.md){others}'
            # Places with more said about them first.
            places = sorted(places, key=lambda p: -len(p.fields.get('facts', [])))
            f.write('\nМеста: ' + '; '.join(place(p) for p in places) +
                    '.\n')
        shown, mentioned = set(), set()
        for p in roots:
            if p in shown:
                continue
            if p not in mentioned or any(c not in shown
                                         for c, v in p.children):
                f.write(f'\n## {self.__name(p)}\n\n')
                self.__write_tree(f, p, None, 0, register, shown, mentioned)
        assert shown | mentioned == set(people), (
            set(people) - shown - mentioned)

    # The surnames of the people, with the number of people who bore each,
    # most common first; feminine forms count with the masculine ones, and
    # a woman under both her birth and her married surname.
    def __surnames(self, people):
        def base(name):
            return name[:-1] if name.endswith(('ова', 'ева', 'ина')) else name

        counts = {}
        for p in people:
            names = {base(v.value) for f in ('surname', 'birth_surname')
                     for v in p.fields.get(f, [])}
            for n in names:
                counts[n] = counts.get(n, 0) + 1
        return sorted(counts.items(), key=lambda c: (-c[1], c[0]))

    def write(self, register):
        for p in register.subjects.values():
            if isinstance(p, PersonId):
                continue
            with open(f'{p.id}.md', 'w', encoding='utf-8') as f:
                self.__write_page(f, p, register)
        os.makedirs('index', exist_ok=True)
        with open('index/README.md', 'w', encoding='utf-8') as f:
            self.__write_index(f, register)


# Writes the register as GEDCOM 5.5.1, for genealogy sites: the people,
# their families and the sources. Facts become notes ending with the ids
# of their sources, «?» before an unreliable one; places have no records
# of their own in GEDCOM, so only places of birth and death are kept.
class GedcomWriter(object):
    PAGES = 'https://github.com/kosarev/kosarev/blob/main/'
    MONTHS = ('JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP',
              'OCT', 'NOV', 'DEC')

    # The sex is told as on the pages, by the given function.
    def __init__(self, male):
        self.male = male

    # A value as plain text: links and copies of documents by their text.
    def __text(self, value):
        if isinstance(value, tuple):
            return ' '.join(''.join(x.text if isinstance(x, (Link, Material))
                                    else str(x) for x in value).split())
        return str(value)

    def __date(self, d):
        if isinstance(d, Between):
            return f'BET {self.__date(d.first)} AND {self.__date(d.last)}'
        return ' '.join(str(x) for x in (
            d.day, d.month and self.MONTHS[d.month - 1], d.year) if x)

    # A line, its text split into CONT lines at line breaks and CONC lines
    # where too long: lines are limited to 255, and some programs count
    # bytes, two for a Cyrillic letter. A split never leaves a space at
    # either side, which some programs drop.
    def __line(self, out, level, tag, text=''):
        for i, part in enumerate(str(text).split('\n')):
            first = True
            while True:
                cut = len(part)
                if cut > 110:
                    cut = 110
                    while part[cut - 1] == ' ' or part[cut] == ' ':
                        cut -= 1
                head, part = part[:cut], part[cut:]
                if i == 0 and first:
                    out.append(f'{level} {tag} {head}'.rstrip())
                else:
                    out.append(f'{level + 1} {"CONT" if first else "CONC"} '
                               f'{head}'.rstrip())
                first = False
                if not part:
                    break

    # Citations of the sources of a value; quality 3 for reliable evidence,
    # 1 for an unreliable source.
    def __cite(self, out, level, sources, note=None):
        for s in sources:
            out.append(f'{level} SOUR @{self.sources[s]}@')
            out.append(f'{level + 1} QUAY {3 if s.reliable else 1}')
            if note:
                self.__line(out, level + 1, 'NOTE', note)

    def __ids(self, sources):
        return ', '.join(('' if s.reliable else '? ') + s.id for s in sources)

    def __name(self, out, p):
        first = p.fields['first_name'][0].value
        given = ' '.join(p.fields[f][0].value
                         for f in ('first_name', 'patronym') if f in p.fields)
        for field, kind in (('surname', None), ('birth_surname', 'birth')):
            for v in p.fields.get(field, [None] if field == 'surname' else []):
                surname = v.value if v else ''
                self.__line(out, 1, 'NAME', f'{given} /{surname}/')
                if kind:
                    out.append(f'2 TYPE {kind}')
                out.append(f'2 GIVN {given}')
                if surname:
                    out.append(f'2 SURN {surname}')
                values = [v] if v else []
                values += [w for f in ('first_name', 'patronym')
                           for w in p.fields.get(f, [])[:1]]
                self.__cite(out, 2, list(dict.fromkeys(
                    s for w in values for s in w.sources)))
        # Other first names and patronyms as names of their own.
        for f in ('first_name', 'patronym'):
            for v in p.fields.get(f, [])[1:]:
                other = (v.value if f == 'first_name' else first)
                if f == 'patronym':
                    other += ' ' + v.value
                elif 'patronym' in p.fields:
                    other += ' ' + p.fields['patronym'][0].value
                surname = (p.fields['surname'][0].value
                           if 'surname' in p.fields else '')
                self.__line(out, 1, 'NAME', f'{other} /{surname}/')
                out.append('2 TYPE aka')
                self.__cite(out, 2, v.sources)

    # An event for each alternative date and place; the first date and
    # place make one event.
    def __event(self, out, p, tag, date, place):
        dates = p.fields.get(date, [])
        places = p.fields.get(place, [])
        events = []
        if dates or places:
            events.append((dates[:1], places[:1]))
        events += [([d], []) for d in dates[1:]]
        events += [([], [q]) for q in places[1:]]
        for ds, qs in events:
            out.append(f'1 {tag}')
            for d in ds:
                out.append(f'2 DATE {self.__date(d.value)}')
            for q in qs:
                self.__line(out, 2, 'PLAC', self.__text(q.value))
            self.__cite(out, 2, list(dict.fromkeys(
                s for v in ds + qs for s in v.sources)))

    def __plain_name(self, p):
        return ' '.join(p.fields[f][0].value
                        for f in ('first_name', 'patronym', 'surname')
                        if f in p.fields)

    def __person(self, out, p):
        assert not p.stepparents and not p.stepchildren, p.id
        out.append(f'0 @{self.people[p]}@ INDI')
        self.__name(out, p)
        out.append(f'1 SEX {"M" if self.male(p) else "F"}')
        self.__event(out, p, 'BIRT', 'birth_date', 'birth_place')
        self.__event(out, p, 'DEAT', 'death_date', 'death_place')
        for v in sorted(p.fields.get('residences', []),
                        key=lambda v: v.value.earliest()):
            out.append('1 RESI')
            out.append(f'2 DATE {self.__date(v.value.date)}')
            self.__line(out, 2, 'PLAC', self.__text(v.value.place))
            self.__cite(out, 2, v.sources)
        for fam in self.families:
            if p in fam['children']:
                out.append(f'1 FAMC @{fam["id"]}@')
            if p in (fam['husband'], fam['wife']):
                out.append(f'1 FAMS @{fam["id"]}@')
        # The sources of the parents, as the families cannot cite them for
        # each child.
        for q, v in p.parents:
            self.__cite(out, 1, v.sources,
                        f'{"Отец" if self.male(q) else "Мать"}: '
                        f'{self.__plain_name(q)}')
        for v in p.fields.get('facts', []):
            self.__line(out, 1, 'NOTE', f'{self.__text(v.value)} '
                                        f'[{self.__ids(v.sources)}]')
        if not isinstance(p, PersonId):
            out.append(f'1 NOTE {self.PAGES}{p.id}.md')

    # The families: a couple with their children, or a parent with the
    # children whose other parent is not known; each partnership with its
    # sources.
    def __families(self, people):
        found = {}

        def family(husband, wife):
            key = (husband, wife)
            if key not in found:
                found[key] = {'id': f'F{len(found) + 1}', 'husband': husband,
                              'wife': wife, 'children': [], 'sources': []}
            return found[key]

        for p in people:
            father = mother = None
            for q, v in p.parents:
                if self.male(q):
                    father = q
                else:
                    mother = q
            if father or mother:
                family(father, mother)['children'].append(p)
            for q, v in p.partners:
                # A GEDCOM family has a husband and a wife.
                assert self.male(p) != self.male(q), (p.id, q.id)
                fam = family(*((p, q) if self.male(p) else (q, p)))
                for s in v.sources:
                    if s not in fam['sources']:
                        fam['sources'].append(s)
        return list(found.values())

    def __source(self, out, s):
        out.append(f'0 @{self.sources[s]}@ SOUR')
        self.__line(out, 1, 'TITL', ('' if s.reliable else '? ') + s.id)
        provider = self.__text(s.provider)
        if provider:
            self.__line(out, 1, 'PUBL', provider)
        notes = ' '.join(''.join(
            f'[{"" if n.reliable else "? "}{n.id}]' if isinstance(n, Source)
            else f'{n.text} ({self.PAGES.replace("/blob/", "/tree/")}'
                 f'{n.path})' if isinstance(n, Material) else str(n)
            for n in s.notes).split())
        if notes:
            self.__line(out, 1, 'TEXT', notes)

    def write(self, register):
        people = [p for p in register.subjects.values()
                  if isinstance(p, Person)]
        self.people = {p: f'I{i + 1}' for i, p in enumerate(people)}
        self.families = self.__families(people)
        out = ['0 HEAD', '1 SOUR kosarev.tproc', '2 NAME Косаревы',
               '1 GEDC', '2 VERS 5.5.1', '2 FORM LINEAGE-LINKED',
               '1 CHAR UTF-8', '1 LANG Russian', '1 SUBM @U1@',
               '0 @U1@ SUBM', '1 NAME Иван Косарев',
               f'1 WWW {self.PAGES}index/README.md']
        # Sources in the order they are first cited, notes included.
        self.sources = {}
        for p in people:
            for f in p.fields.values():
                for v in f:
                    for s in v.sources:
                        pending = [s]
                        while pending:
                            t = pending.pop(0)
                            if t not in self.sources:
                                self.sources[t] = f'S{len(self.sources) + 1}'
                                pending += [n for n in t.notes
                                            if isinstance(n, Source)]
        for p in people:
            self.__person(out, p)
        for fam in self.families:
            out.append(f'0 @{fam["id"]}@ FAM')
            if fam['husband']:
                out.append(f'1 HUSB @{self.people[fam["husband"]]}@')
            if fam['wife']:
                out.append(f'1 WIFE @{self.people[fam["wife"]]}@')
            for c in fam['children']:
                out.append(f'1 CHIL @{self.people[c]}@')
            self.__cite(out, 1, fam['sources'])
        for s in self.sources:
            self.__source(out, s)
        out.append('0 TRLR')
        with open('kosarev.ged', 'w', encoding='utf-8-sig') as f:
            f.write('\n'.join(out) + '\n')


# Reads the given definition's records into a register. The records
# refer to sources by id, and a source may come after the records that
# cite it; the register gets the sources themselves.
def read(name):
    sources, records = {}, []
    for t in tproc.expand_field(name):
        if isinstance(t, Source):
            # Ids with '-at-' are left for citations made from other ids.
            assert '-at-' not in t.id, t.id
            assert t.id not in sources, t.id
            sources[t.id] = t
        elif isinstance(t, Record):
            records.append(t)
        else:
            assert not t.strip(), t

    for s in sources.values():
        s.notes = tuple(sources[n.id] if isinstance(n, Cite) else n
                        for n in s.notes)
    r = Register()
    for t in records:
        for v in t.values:
            for id in t.sources:
                r.add_field(t.subject, v.field, v.value, sources[id])
    return r


# Writes a page for each person, and the whole tree as GEDCOM.
def main():
    register = read('records')
    writer = MarkdownWriter()
    writer.write(register)
    GedcomWriter(writer.male).write(register)
