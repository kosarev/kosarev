@
# A value and the sources that give it.
class Value(object):
    def __init__(self, value):
        self.value = value
        self.sources = []


class Person(object):
    def __init__(self, id):
        self.id = id
        # Each field is a list of alternative values. A value given by
        # several sources is one value with several sources.
        self.fields = {}

    def add(self, field, value, source):
        values = self.fields.setdefault(field, [])
        for v in values:
            if v.value == value:
                break
        else:
            v = Value(value)
            values.append(v)
        if source not in v.sources:
            v.sources.append(source)


# Keeps the sources, and the people assembled from field values. Values
# refer to their sources by id, so a record may come before its source.
class Register(object):
    def __init__(self):
        self.sources = {}
        self.people = {}

    def add_source(self, source):
        assert source.id not in self.sources, source.id
        self.sources[source.id] = source

    def add_field(self, subject, field, value, source):
        p = self.people.setdefault(subject, Person(subject))
        p.add(field, value, source)


def text(tokens):
    return ''.join(t.content for t in tokens
                   if isinstance(t.content, str)).strip()


# A field's value, as given in a record.
class FieldValue(object):
    def __init__(self, field, value):
        self.field = field
        self.value = text(value)


def first_name(value):
    return FieldValue('first_name', value)


def patronym(value):
    return FieldValue('patronym', value)


def surname(value):
    return FieldValue('surname', value)


def birth_surname(value):
    return FieldValue('birth_surname', value)


# The id of the subject's father.
def father(value):
    return FieldValue('father', value)


# The id of one of the subject's partners; all may be true at once.
def partner(value):
    return FieldValue('partner', value)


# A citation of a source, by id, in the notes of another source.
class Cite(object):
    def __init__(self, id):
        self.id = text(id)


cite = Cite


# A piece of evidence: who provided it, whether it is reliable, and notes
# on what it is -- text and citations of other sources.
class Source(object):
    def __init__(self, id, provider, notes, reliable):
        self.id = text(id)
        self.provider = text(provider)
        self.reliable = reliable
        self.notes = []
        for t in notes:
            if isinstance(t.content, Cite):
                self.notes.append(t.content)
            elif self.notes and isinstance(self.notes[-1], str):
                self.notes[-1] += t.content
            else:
                self.notes.append(t.content)


def source(id, provider, notes=()):
    return Source(id, provider, notes, reliable=True)


def unreliable_source(id, provider, notes=()):
    return Source(id, provider, notes, reliable=False)


# What a source says about a subject: the values of its fields.
class Record(object):
    def __init__(self, source, subject, values):
        self.source = text(source)
        self.subject = text(subject)
        self.values = []
        for t in values:
            if isinstance(t.content, FieldValue):
                self.values.append(t.content)
            else:
                assert not t.content.strip(), t.content


record = Record


# Writes the register as Markdown: a page for each person.
class MarkdownWriter(object):
    NAME_FIELDS = ('first_name', 'patronym', 'surname')

    def __name(self, p):
        return ' '.join(p.fields[f][0].value for f in self.NAME_FIELDS
                        if f in p.fields)

    # Tells whether a person is male by the patronym.
    def __male(self, p):
        patronym = p.fields['patronym'][0].value
        if patronym.endswith('ич'):
            return True
        assert patronym.endswith('на'), patronym
        return False

    # The people whose father is the given person, each with the value
    # that says so.
    def __children(self, p, register):
        return [(c, v) for c in register.people.values()
                for v in c.fields.get('father', []) if v.value == p.id]

    # The person's partners, recorded on either side, each with the value
    # that says so.
    def __partners(self, p, register):
        partners = [(register.people[v.value], v)
                    for v in p.fields.get('partner', [])]
        partners += [(q, v) for q in register.people.values()
                     for v in q.fields.get('partner', []) if v.value == p.id]
        return partners

    # Sources are footnotes, numbered on the page in the order they are
    # first cited.
    def __write_page(self, f, p, register):
        sources = []

        def ref(id):
            if id not in sources:
                sources.append(id)
            return f'[^{sources.index(id) + 1}]'

        # A value is reliable only if all its sources are.
        def refs(value):
            reliable = all(register.sources[s].reliable
                           for s in value.sources)
            return (('' if reliable else '<sup>?</sup>') +
                    ''.join(ref(s) for s in value.sources))

        # If all the parts of the name have the same sources, mark only the
        # last one.
        parts = [p.fields[f][0] for f in self.NAME_FIELDS if f in p.fields]
        same = len(set(tuple(v.sources) for v in parts)) == 1
        f.write('# ' + ' '.join(v.value + (refs(v) if not same or
                                           v is parts[-1] else '')
                                for v in parts) + '\n')

        if 'birth_surname' in p.fields:
            v = p.fields['birth_surname'][0]
            f.write(f'\n({v.value}{refs(v)})\n')

        # A relation's title on a line of its own, then each person on a
        # line of their own.
        def relation(title, people):
            f.write(f'\n**{title}:**\n')
            for q, v in people:
                f.write(f'- [{self.__name(q)}]({q.id}.md){refs(v)}\n')

        if 'father' in p.fields:
            v = p.fields['father'][0]
            relation('Отец', [(register.people[v.value], v)])

        if partners := self.__partners(p, register):
            if len(partners) > 1:
                title = 'Супруги'
            else:
                title = 'Супруг' if self.__male(partners[0][0]) else 'Супруга'
            relation(title, partners)

        if children := self.__children(p, register):
            if len(children) > 1:
                title = 'Дети'
            else:
                title = 'Сын' if self.__male(children[0][0]) else 'Дочь'
            relation(title, children)

        # Citations in the notes add more sources as they are written.
        f.write('\n')
        i = 0
        while i < len(sources):
            s = register.sources[sources[i]]
            notes = ''.join(ref(n.id) if isinstance(n, Cite) else n
                            for n in s.notes)
            notes = ' '.join(notes.split())
            text = ' — '.join(t for t in (notes, s.provider) if t)
            f.write(f'[^{i + 1}]: {"" if s.reliable else "? "}{text}\n')
            i += 1

    def write(self, register):
        for p in register.people.values():
            with open(f'{p.id}.md', 'w', encoding='utf-8') as f:
                self.__write_page(f, p, register)


# Writes a page for each person.
def main():
    # Process records.
    r = Register()
    for t in tproc.expand_field('records'):
        if isinstance(t, Source):
            r.add_source(t)
        elif isinstance(t, Record):
            for v in t.values:
                r.add_field(t.subject, v.field, v.value, t.source)
        else:
            assert not t.strip(), t

    # Write output files.
    MarkdownWriter().write(r)
