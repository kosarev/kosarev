@
import os


# A value and the sources that give it.
class Value(object):
    def __init__(self, value):
        self.value = value
        self.sources = []


# A person or a place: what the records say about it.
class Subject(object):
    def __init__(self, id):
        self.id = id
        # Each field is a list of alternative values. A value given by
        # several sources is one value with several sources.
        self.fields = {}

    def add(self, field, value, source):
        values = self.fields.setdefault(field, [])
        for v in values:
            if v.value == value:
                break
        else:
            v = Value(value)
            values.append(v)
        if source not in v.sources:
            v.sources.append(source)


# Keeps the sources, and the subjects assembled from field values. Values
# refer to their sources by id, so a record may come before its source.
class Register(object):
    def __init__(self):
        self.sources = {}
        self.subjects = {}

    def add_source(self, source):
        assert source.id not in self.sources, source.id
        self.sources[source.id] = source

    def add_field(self, subject, field, value, source):
        s = self.subjects.setdefault(subject, Subject(subject))
        s.add(field, value, source)


def text(tokens):
    return ''.join(t.content for t in tokens
                   if isinstance(t.content, str)).strip()


# The rest of a field from the given argument on. tproc splits arguments
# at colons, so the colons in text come as separate arguments; this joins
# them back.
def rest(*parts):
    for i, part in enumerate(parts):
        if i:
            yield tproc.LiteralToken(':')
        yield from part


# The one value of the given tokens: an object, such as a date, or else
# the text.
def content(tokens):
    tokens = list(tokens)
    objects = [t.content for t in tokens if not isinstance(t.content, str)]
    if objects:
        assert len(objects) == 1, objects
        assert not text(tokens), tokens
        return objects[0]
    return text(tokens)


# Text with objects in it, such as citations and links: a tuple of
# strings and objects, with runs of text joined.
def pieces(tokens):
    result = []
    for t in tokens:
        if isinstance(t.content, str) and result and isinstance(result[-1],
                                                                str):
            result[-1] += t.content
        else:
            result.append(t.content)
    return tuple(result)


MONTHS = ('январь', 'февраль', 'март', 'апрель', 'май', 'июнь', 'июль',
          'август', 'сентябрь', 'октябрь', 'ноябрь', 'декабрь')
MONTHS_OF = ('января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля',
             'августа', 'сентября', 'октября', 'ноября', 'декабря')


# A date: a year, possibly with a month and a day.
class Date(object):
    def __init__(self, year, month=None, day=None):
        self.year = year
        self.month = month
        self.day = day

    def __eq__(self, other):
        return (isinstance(other, Date) and
                (self.year, self.month, self.day) ==
                (other.year, other.month, other.day))

    def __hash__(self):
        return hash((self.year, self.month, self.day))

    # The earliest and the latest day the date may be.
    def earliest(self):
        return (self.year, self.month or 1, self.day or 1)

    def latest(self):
        return (self.year, self.month or 12, self.day or 31)

    def __str__(self):
        if self.day:
            return f'{self.day} {MONTHS_OF[self.month - 1]} {self.year}'
        if self.month:
            return f'{MONTHS[self.month - 1]} {self.year}'
        return str(self.year)


# {date::year:month:day}, the month and the day being optional.
def date(*parts):
    return Date(*(int(text(p)) for p in parts))


# A date known to be between two dates.
class Between(object):
    def __init__(self, first, last):
        self.first = first
        self.last = last

    def __eq__(self, other):
        return (isinstance(other, Between) and
                (self.first, self.last) == (other.first, other.last))

    def __hash__(self):
        return hash((self.first, self.last))

    def __str__(self):
        return f'между {self.first} и {self.last}'


def between(first, last):
    return Between(content(first), content(last))


# A field's value, as given in a record.
class FieldValue(object):
    def __init__(self, field, value):
        self.field = field
        self.value = value


def name(value):
    return FieldValue('name', content(value))


def first_name(value):
    return FieldValue('first_name', content(value))


def patronym(value):
    return FieldValue('patronym', content(value))


def surname(value):
    return FieldValue('surname', content(value))


def birth_surname(value):
    return FieldValue('birth_surname', content(value))


def birth_date(value):
    return FieldValue('birth_date', content(value))


def death_date(value):
    return FieldValue('death_date', content(value))


def birth_place(*text):
    return FieldValue('birth_place', pieces(rest(*text)))


def death_place(*text):
    return FieldValue('death_place', pieces(rest(*text)))


# A link to a subject's page, with the text to show for it.
class Link(object):
    def __init__(self, id, text):
        self.id = id
        self.text = text

    def __eq__(self, other):
        return (isinstance(other, Link) and
                (self.id, self.text) == (other.id, other.text))

    def __hash__(self):
        return hash((self.id, self.text))


def link(id, *shown):
    return Link(text(id), text(rest(*shown)))


# A free-text fact about the subject, possibly with links; all facts may
# be true at once.
def fact(*text):
    return FieldValue('facts', pieces(rest(*text)))


# The id of the subject's father.
def father(value):
    return FieldValue('father', content(value))


# The id of the subject's mother.
def mother(value):
    return FieldValue('mother', content(value))


# The id of one of the subject's partners; all may be true at once.
def partner(value):
    return FieldValue('partner', content(value))


# A citation of a source, by id, in the notes of another source.
class Cite(object):
    def __init__(self, id):
        self.id = text(id)


cite = Cite


# A copy of a document, kept in the repository under materials/: a
# directory with the copy and a README.md describing it, or a file in it.
# Shown as the given text, or else as its path.
class Material(object):
    def __init__(self, path, *shown):
        self.path = 'materials/' + text(path)
        self.text = text(rest(*shown)) if shown else self.path


material = Material


# A web page, as a source's provider.
class Url(object):
    def __init__(self, address):
        self.address = address

    def __str__(self):
        return self.address


def url(*address):
    return Url(text(rest(*address)))


# A piece of evidence: where it comes from -- a person, a page or a name --
# whether it is reliable, and notes on what it is: text and citations of
# other sources.
class Source(object):
    def __init__(self, id, provider, notes, reliable):
        self.id = text(id)
        self.provider = pieces(provider)
        self.reliable = reliable
        self.notes = pieces(notes)


def source(id, provider, *notes):
    return Source(id, provider, rest(*notes), reliable=True)


def unreliable_source(id, provider, *notes):
    return Source(id, provider, rest(*notes), reliable=False)


# What sources say about a subject: the values of its fields. Several
# sources, separated by spaces, all give every value.
class Record(object):
    def __init__(self, sources, subject, values):
        self.sources = text(sources).split()
        self.subject = text(subject)
        self.values = []
        for t in values:
            if isinstance(t.content, FieldValue):
                self.values.append(t.content)
            else:
                assert not t.content.strip(), t.content


record = Record


# Writes the register as Markdown: a page for each person.
class MarkdownWriter(object):
    # A place has a name; a person's name is in parts.
    NAME_FIELDS = ('name', 'first_name', 'patronym', 'surname')

    def __name(self, p):
        return ' '.join(p.fields[f][0].value for f in self.NAME_FIELDS
                        if f in p.fields)

    # First names to tell the sex by when there is neither a patronym nor
    # a surname.
    MALES = ()
    FEMALES = ('Лукерья',)

    # Tells whether a person is male by the patronym, or else by the
    # surname, or else by the first name.
    def __male(self, p):
        if 'patronym' in p.fields:
            patronym = p.fields['patronym'][0].value
            if patronym.endswith('ич'):
                return True
            assert patronym.endswith('на'), patronym
            return False
        if 'surname' not in p.fields:
            first_name = p.fields['first_name'][0].value
            assert first_name in self.MALES + self.FEMALES, first_name
            return first_name in self.MALES
        surname = p.fields['surname'][0].value
        if surname.endswith(('ов', 'ев', 'ин')):
            return True
        assert surname.endswith(('ова', 'ева', 'ина')), surname
        return False

    # A value as text; places and facts may have links in them.
    def __shown(self, value):
        if isinstance(value, tuple):
            return ' '.join(''.join(f'[{x.text}]({x.id}.md)'
                                    if isinstance(x, Link) else
                                    f'[{x.text}]({x.path})'
                                    if isinstance(x, Material) else x
                                    for x in value).split())
        return str(value)

    # The age at death, in full years, or the range of the ages possible,
    # when both dates are known.
    def __age(self, p):
        if 'birth_date' not in p.fields or 'death_date' not in p.fields:
            return None
        birth = p.fields['birth_date'][0].value
        death = p.fields['death_date'][0].value
        if not isinstance(birth, Date) or not isinstance(death, Date):
            return None

        def years(a, b):
            return b[0] - a[0] - (b[1:] < a[1:])

        least = years(birth.latest(), death.earliest())
        most = years(birth.earliest(), death.latest())
        n = most % 100
        word = ('лет' if 11 <= n <= 14 else 'год' if n % 10 == 1 else
                'года' if 2 <= n % 10 <= 4 else 'лет')
        return (f'{least} {word}' if least == most else
                f'{least}–{most} {word}')

    # The middle of a person's known birth date, to order people by; those
    # of unknown birth come last.
    def __birth(self, p):
        if 'birth_date' not in p.fields:
            return float('inf')
        d = p.fields['birth_date'][0].value
        if isinstance(d, Between):
            return (d.first.year + d.last.year) / 2
        return d.year

    # The people whose father or mother is the given person, each with the
    # value that says so, by birth.
    def __children(self, p, register):
        return sorted(((c, v) for c in register.subjects.values()
                       for f in ('father', 'mother')
                       for v in c.fields.get(f, []) if v.value == p.id),
                      key=lambda t: self.__birth(t[0]))

    # The person's partners, recorded on either side, each with a value
    # whose sources are those of all the values that say so.
    def __partners(self, p, register):
        found = [(register.subjects[v.value], v)
                 for v in p.fields.get('partner', [])]
        found += [(q, v) for q in register.subjects.values()
                  for v in q.fields.get('partner', []) if v.value == p.id]
        partners = {}
        for q, v in found:
            both = partners.setdefault(q, Value(None))
            for s in v.sources:
                if s not in both.sources:
                    both.sources.append(s)
        return list(partners.items())

    # The people with the same father or mother as the given person, each
    # with a value whose sources are those of all the parents' values that
    # make them siblings.
    def __siblings(self, p, register):
        siblings = {}
        for f in ('father', 'mother'):
            for v in p.fields.get(f, []):
                parent = register.subjects[v.value]
                for c, w in self.__children(parent, register):
                    if c is p:
                        continue
                    both = siblings.setdefault(c, Value(None))
                    for s in v.sources + w.sources:
                        if s not in both.sources:
                            both.sources.append(s)
        return sorted(siblings.items(), key=lambda t: self.__birth(t[0]))

    # Sources are listed at the end of the page, each under a heading of its
    # id, so it can be linked to: page.md#source-id. They are numbered on
    # the page in the order they are first cited; marks link to them.
    def __write_page(self, f, p, register):
        sources = []

        def ref(id):
            if id not in sources:
                sources.append(id)
            return f'[{sources.index(id) + 1}](#{id})'

        # A value is reliable only if all its sources are.
        def reliable(value):
            return all(register.sources[s].reliable for s in value.sources)

        def refs(value):
            return ('<sup>' + ('' if reliable(value) else '? ') +
                    ', '.join(ref(s) for s in value.sources) + '</sup>')

        # The given fields, joined with the separator, each with its
        # alternatives, reliable ones first, joined with «или». If all the
        # values have the same sources, only the last one is marked.
        def shown(names, separator):
            fields = [sorted(p.fields[n], key=lambda v: not reliable(v))
                      for n in names if n in p.fields]
            values = [v for alternatives in fields for v in alternatives]
            same = len(set(tuple(v.sources) for v in values)) == 1
            return separator.join(
                ' или '.join(self.__shown(v.value) +
                             (refs(v) if not same or v is values[-1] else '')
                             for v in alternatives)
                for alternatives in fields)

        f.write(f'# {shown(self.NAME_FIELDS, " ")}\n')

        if 'birth_surname' in p.fields:
            f.write(f'\n({shown(("birth_surname",), "")})\n')

        def event(names):
            return shown(names, ', ')

        if 'birth_date' in p.fields or 'birth_place' in p.fields:
            f.write(f'\n**{"Родился" if self.__male(p) else "Родилась"}:** '
                    f'{event(("birth_date", "birth_place"))}\n')

        if 'death_date' in p.fields or 'death_place' in p.fields:
            age = self.__age(p)
            f.write(f'\n**{"Умер" if self.__male(p) else "Умерла"}:** '
                    f'{event(("death_date", "death_place"))}'
                    f'{f" ({age})" if age else ""}\n')

        # A relation's title on a line of its own, then each person on a
        # line of their own.
        def relation(title, people):
            f.write(f'\n**{title}:**\n')
            for q, v in people:
                f.write(f'- [{self.__name(q)}]({q.id}.md){refs(v)}\n')

        parents = [(register.subjects[p.fields[n][0].value], p.fields[n][0])
                   for n in ('father', 'mother') if n in p.fields]
        if parents:
            title = ('Родители' if len(parents) > 1 else
                     'Отец' if 'father' in p.fields else 'Мать')
            relation(title, parents)

        if partners := self.__partners(p, register):
            if len(partners) > 1:
                title = 'Супруги'
            else:
                title = 'Супруг' if self.__male(partners[0][0]) else 'Супруга'
            relation(title, partners)

        if children := self.__children(p, register):
            if len(children) > 1:
                title = 'Дети'
            else:
                title = 'Сын' if self.__male(children[0][0]) else 'Дочь'
            relation(title, children)

        if siblings := self.__siblings(p, register):
            males = sum(1 for c, v in siblings if self.__male(c))
            females = len(siblings) - males
            titles = [t for t in (
                'Братья' if males > 1 else 'Брат' if males else '',
                'Сестры' if females > 1 else 'Сестра' if females else '')
                if t]
            relation(' и '.join(titles[:1] + [t.lower() for t in titles[1:]]),
                     siblings)

        # Facts come last, each a paragraph of its own.
        for v in p.fields.get('facts', []):
            f.write(f'\n{self.__shown(v.value)}{refs(v)}\n')

        # Citations in the notes add more sources as they are written.
        f.write('\n## Источники\n')
        i = 0
        while i < len(sources):
            s = register.sources[sources[i]]
            notes = ''.join(ref(n.id) if isinstance(n, Cite) else
                            f'[{n.text}]({n.path})'
                            if isinstance(n, Material) else str(n)
                            for n in s.notes)
            notes = ' '.join(notes.split())
            provider = ''.join(str(x) for x in s.provider).strip()
            text = ' — '.join(t for t in (notes, provider) if t)
            f.write(f'\n### {s.id}\n\n'
                    f'[{i + 1}] {"" if s.reliable else "? "}{text}\n')
            i += 1

    # The years of birth and death, for the index.
    def __years(self, p):
        def years(d):
            if isinstance(d, Between):
                return f'{d.first.year}–{d.last.year}'
            return str(d.year)

        parts = [f'{prefix} {years(p.fields[n][0].value)}'
                 for n, prefix in (('birth_date', 'р.'), ('death_date', 'ум.'))
                 if n in p.fields]
        return f' ({", ".join(parts)})' if parts else ''

    def __descendants(self, p, register):
        found = set()
        for c, v in self.__children(p, register):
            if c not in found:
                found |= {c} | self.__descendants(c, register)
        return found

    # A person of the index tree with their partners, and their children
    # nested under them. A link to a parent or a partner that rests on a
    # guess is marked «?». A partner is only mentioned: they still appear
    # in the tree of their own parents.
    def __write_tree(self, f, p, v, depth, register, shown, mentioned):
        def mark(v):
            reliable = all(register.sources[s].reliable for s in v.sources)
            return '' if reliable else '? '

        def link(q):
            return f'[{self.__name(q)}](../{q.id}.md)'

        shown.add(p)
        line = (f'{"  " * depth}- {mark(v) if v else ""}{link(p)}'
                f'{self.__years(p)}')
        if partners := self.__partners(p, register):
            if len(partners) > 1:
                title = 'супруги'
            else:
                title = 'супруг' if self.__male(partners[0][0]) else 'супруга'
            line += f' — {title}: ' + ', '.join(mark(w) + link(q)
                                                for q, w in partners)
            mentioned.update(q for q, w in partners)
        f.write(line + '\n')
        for c, w in self.__children(p, register):
            if c not in shown:
                self.__write_tree(f, c, w, depth + 1, register, shown,
                                  mentioned)

    # The index: a tree for each earliest known ancestor, bigger trees
    # first, so that each person is shown once, with most of their family;
    # those mentioned as partners get no tree of their own. Then the
    # places.
    def __write_index(self, f, register):
        people = [p for p in register.subjects.values()
                  if 'name' not in p.fields]
        places = [p for p in register.subjects.values()
                  if 'name' in p.fields]
        roots = [p for p in people
                 if 'father' not in p.fields and 'mother' not in p.fields]
        roots.sort(key=lambda p: (-len(self.__descendants(p, register)),
                                  not self.__male(p), self.__birth(p)))
        f.write('# Косаревы\n\n'
                'Деревья — по самым ранним известным предкам; дети — под '
                'родителями, по году рождения. «?» — связь с родителем или '
                'супругом предположительна.\n')
        shown, mentioned = set(), set()
        for p in roots:
            if p not in shown | mentioned:
                f.write(f'\n## {self.__name(p)}\n\n')
                self.__write_tree(f, p, None, 0, register, shown, mentioned)
        assert shown | mentioned == set(people), (
            set(people) - shown - mentioned)
        f.write('\n## Места\n\n')
        for p in places:
            f.write(f'- [{self.__name(p)}](../{p.id}.md)\n')

    def write(self, register):
        for p in register.subjects.values():
            with open(f'{p.id}.md', 'w', encoding='utf-8') as f:
                self.__write_page(f, p, register)
        os.makedirs('index', exist_ok=True)
        with open('index/README.md', 'w', encoding='utf-8') as f:
            self.__write_index(f, register)


# Writes a page for each person.
def main():
    # Process records.
    r = Register()
    for t in tproc.expand_field('records'):
        if isinstance(t, Source):
            r.add_source(t)
        elif isinstance(t, Record):
            for v in t.values:
                for s in t.sources:
                    r.add_field(t.subject, v.field, v.value, s)
        else:
            assert not t.strip(), t

    # Write output files.
    MarkdownWriter().write(r)
